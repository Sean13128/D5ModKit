  "evidence": "magichange/rows.json, magichange/offline_proof_magichange.json"
 },
 "rules": {
  "row_id": "10000 + the character's registry identity + n (the ownership manifest's special_id band 10000-39999, the same rule d5lib.charstudio.free_skill_id uses); the first free n above the character's own skill rows",
  "shape": "the body template family's own row count: Imp 2020 ships 3 rows (single / 64-SP pair / dual), Shroom 2100 ships 2 (single / pair) - a character never grows a Dual Magichange its body family does not have",
  "numbers": "the donor row's numbers, animation id, area, height, effects and element are kept (adapted); D4's name and text are carried in all five locales, with D4's status-marker parenthetical dropped because D4's own marker bytes are not valid in the D5 text table",
  "level": "D4's own level for that attack in the D4 char.dat learnset"
 },
